#include <windows.h>
#include <commctrl.h>

1 ICON "pigeon.ico"
1 24 "pigeon.manifest"

101 DIALOGEX 0, 0, 272, 392
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "pigeon settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "ACCOUNTS", 4100, 10, 2, 120, 9
    LTEXT           "", 4000, 4, 13, 264, 108, NOT WS_VISIBLE
    CONTROL         "", 1001, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | WS_TABSTOP, 14, 21, 246, 76
    PUSHBUTTON      "Add", 1002, 12, 102, 54, 15
    PUSHBUTTON      "Remove", 1003, 70, 102, 54, 15
    PUSHBUTTON      "Fix sign-in", 1018, 128, 102, 54, 15

    LTEXT           "NOTIFICATIONS", 4101, 10, 128, 120, 9
    LTEXT           "", 4001, 4, 139, 264, 104, NOT WS_VISIBLE
    LTEXT           "Show popups for", -1, 14, 151, 64, 10
    EDITTEXT        1004, 84, 149, 20, 13, ES_NUMBER
    LTEXT           "seconds", -1, 112, 151, 40, 10
    LTEXT           "Corner", -1, 14, 172, 40, 10
    CONTROL         "Top left", 1021, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 84, 167, 30, 18
    CONTROL         "Top right", 1020, "Button", BS_AUTORADIOBUTTON, 118, 167, 30, 18
    CONTROL         "Bottom left", 1023, "Button", BS_AUTORADIOBUTTON, 152, 167, 30, 18
    CONTROL         "Bottom right", 1022, "Button", BS_AUTORADIOBUTTON, 186, 167, 30, 18
    AUTOCHECKBOX    "Play sound", 1005, 14, 192, 110, 12, WS_GROUP
    AUTOCHECKBOX    "Start with Windows", 1010, 140, 192, 120, 12
    AUTOCHECKBOX    "Hold popups during fullscreen apps", 1011, 14, 209, 220, 12
    AUTOCHECKBOX    "Quiet hours from", 1012, 14, 226, 78, 12
    CONTROL         "", 1040, "msctls_updown32", 0, 96, 225, 9, 13
    EDITTEXT        1013, 106, 225, 40, 13, ES_READONLY | ES_CENTER
    LTEXT           "to", -1, 152, 227, 10, 10
    CONTROL         "", 1041, "msctls_updown32", 0, 164, 225, 9, 13
    EDITTEXT        1014, 174, 225, 40, 13, ES_READONLY | ES_CENTER

    LTEXT           "FILTERS", 4102, 10, 250, 120, 9
    LTEXT           "", 4002, 4, 261, 264, 60, NOT WS_VISIBLE
    LTEXT           "Only notify from", -1, 14, 272, 80, 10
    EDITTEXT        1015, 102, 270, 156, 13, ES_AUTOHSCROLL
    LTEXT           "Never notify from", -1, 14, 290, 80, 10
    EDITTEXT        1016, 102, 288, 156, 13, ES_AUTOHSCROLL
    AUTOCHECKBOX    "No popups for Promotions and Social (Gmail)", 1017, 14, 305, 240, 12

    LTEXT           "SOUND", 4103, 10, 328, 120, 9
    LTEXT           "", 4003, 4, 339, 264, 24, NOT WS_VISIBLE
    EDITTEXT        1006, 14, 345, 182, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", 1007, 206, 343, 54, 15

    PUSHBUTTON      "Test popup", 1008, 4, 370, 60, 16
    PUSHBUTTON      "Close", IDCANCEL, 208, 370, 60, 16
END

102 DIALOGEX 0, 0, 220, 118
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add mail account"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Email address:", -1, 8, 8, 200, 10
    EDITTEXT        2001, 10, 20, 200, 13, ES_AUTOHSCROLL
    LTEXT           "", 2004, 8, 70, 204, 18
    LTEXT           "App password:", 2005, 8, 40, 204, 10
    EDITTEXT        2002, 10, 51, 200, 13, ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON      "Get app password...", 2003, 8, 96, 80, 14
    DEFPUSHBUTTON   "Add", IDOK, 108, 96, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 96, 50, 14
END

103 DIALOGEX 0, 0, 180, 188
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "pigeon test menu"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    PUSHBUTTON      "Short popup", 3001, 8, 8, 164, 16
    PUSHBUTTON      "Long subject", 3002, 8, 28, 164, 16
    PUSHBUTTON      "Several mails at once (+3 more)", 3003, 8, 48, 164, 16
    PUSHBUTTON      "Queue of 3 mails", 3004, 8, 68, 164, 16
    PUSHBUTTON      "One popup per account", 3005, 8, 88, 164, 16
    PUSHBUTTON      "Sound only", 3006, 8, 108, 164, 16
    PUSHBUTTON      "Recheck last 5 real mails", 3007, 8, 128, 164, 16
    PUSHBUTTON      "Simulate startup (unread mail)", 3008, 8, 148, 164, 16
    PUSHBUTTON      "Close", IDCANCEL, 122, 168, 50, 14
END
